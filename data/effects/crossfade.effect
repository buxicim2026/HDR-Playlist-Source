uniform float4x4 ViewProj;
uniform texture2d tex_a;
uniform texture2d tex_b;
uniform float fade_val;

sampler_state textureSampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float2 uv : TEXCOORD0;
	float4 pos : POSITION;
};

struct FragData {
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
	VertData vert_out;
	vert_out.uv = v_in.uv;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	return vert_out;
}

/* Plain lerp, exactly like OBS's own fade transition: the sRGB handling is
 * done by the sampler/framebuffer state set up around the draw
 * (gs_effect_set_texture_srgb + gs_enable_framebuffer_srgb), so the shader
 * must stay trivial. Anything fancy here (ternary expressions, helper
 * functions returning float3, pow) risks the effect failing to compile, and a
 * failing effect means the playlist silently degrades to hard cuts. */
float4 PSCrossfade(FragData f_in) : TARGET {
	float4 a_val = tex_a.Sample(textureSampler, f_in.uv);
	float4 b_val = tex_b.Sample(textureSampler, f_in.uv);
	return lerp(a_val, b_val, fade_val);
}

float4 PSCrossfadeSingle(FragData f_in) : TARGET {
	float4 a_val = tex_a.Sample(textureSampler, f_in.uv);
	return a_val * fade_val;
}

technique Fade {
	pass {
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSCrossfade(f_in);
	}
}

/* Kept as a separate technique so the HDR path keeps working unchanged. */
technique FadeLinear {
	pass {
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSCrossfade(f_in);
	}
}

technique FadeSingle {
	pass {
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSCrossfadeSingle(f_in);
	}
}
